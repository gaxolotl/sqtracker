{
  "engines": {
    "node": ">=22.0.0"
  },
  "name": "sqtracker",
  "version": "1.5.0",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "api",
    "client"
  ],
  "scripts": {
    "api:dev": "yarn workspace @sqtracker/api dev",
    "client:dev": "yarn workspace @sqtracker/client dev",
    "dev": "npm-run-all --parallel api:dev client:dev",
    "lint": "prettier --write --ignore-path=.eslintignore \"**/*.{js,json}\""
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "content-disposition": "^2.0.1",
    "eslint": "10.7.0",
    "eslint-config-next": "^16.2.10",
    "next": "^16.2.10",
    "pretty-bytes": "^7.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^17.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.4.3"
  }
}
