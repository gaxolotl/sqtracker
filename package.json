{
  "engines": {
    "node": ">=22.0.0"
  },
  "name": "sqtracker",
  "version": "2.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "api",
    "client",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "api:dev": "pnpm --filter @sqtracker/api dev",
    "client:dev": "pnpm --filter @sqtracker/client dev",
    "dev": "npm-run-all --parallel api:dev client:dev",
    "client:build": "pnpm --filter @sqtracker/client build",
    "lint": "prettier --write --ignore-path=.eslintignore \"**/*.{js,json}\""
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {}
}
